{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "allow-start-transcription",
    "allow-flatten-transcript",
    "allow-apply-speaker-names",
    "allow-save-hf-token",
    "allow-hf-token-status",
    "allow-test-hf-token"
  ]
}
