{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "transcriptor",
  "version": "0.1.0",
  "identifier": "com.ivan.transcriptor",
  "build": {
    "beforeDevCommand": "pnpm fetch-binaries && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm fetch-binaries && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Transcriptor",
        "width": 960,
        "height": 760,
        "minWidth": 640,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/uv", "binaries/ffmpeg"],
    "resources": ["resources/diarize.py"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
